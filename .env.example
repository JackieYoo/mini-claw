# MiniClaw 配置示例
# 复制此文件为 .env 并填写实际值

# ========== 应用配置 ==========
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ========== AI 模型配置 ==========
# OpenAI API (可选)
MODEL_PROVIDER=openai
MODEL_API_KEY=sk-xxx
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 或使用其他兼容 OpenAI API 的服务
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# ========== 飞书配置 ==========
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_DOMAIN=feishu  # 或 lark（海外版）

# 飞书表情回复配置
FEISHU_REACTIONS_ENABLED=true
FEISHU_REACTIONS_SHOW_RECEIVED=true
FEISHU_REACTIONS_SHOW_PROCESSING=true
FEISHU_REACTIONS_SHOW_RESULT=true

# ========== 安全配置 ==========
# API 认证密钥（逗号分隔多个密钥）
# 使用 node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" 生成
API_KEYS=sk-your-api-key-1,sk-your-api-key-2

# WebSocket 认证 token（留空则禁用认证）
WS_AUTH_TOKEN=

# 会话加密密钥（推荐设置，至少32字符）
SESSION_ENCRYPTION_KEY=

# 文件访问白名单路径（逗号分隔）
ALLOWED_PATHS=/Users,/home,/tmp

# HTTP 请求安全配置
# 是否允许访问内网地址（默认禁止）
HTTP_ALLOW_PRIVATE_NETWORK=false

# Shell 命令黑名单（正则表达式）
# DANGEROUS_COMMANDS=rm -rf /,mkfs,dd if=

# ========== 会话配置 ==========
SESSION_MAX_MESSAGES=50
SESSION_MAX_COUNT=1000
SESSION_DM_SCOPE=per-channel-peer  # 或 main

# ========== 工具配置 ==========
# 搜索 API（可选）
# SEARCH_API_KEY=xxx
# SEARCH_ENGINE=google  # google, bing, duckduckgo

# HTTP 请求超时（毫秒）
HTTP_TIMEOUT=30000

# ========== 日志配置 ==========
# 日志文件路径
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ========== PM2 配置 ==========
# pm2 start ecosystem.config.cjs
# pm2 stop mini-claw
# pm2 restart mini-claw
# pm2 logs mini-claw
